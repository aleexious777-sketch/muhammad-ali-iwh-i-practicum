doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Plants
        a.nav-link(href="/update-cobj") Add to this table
        .table-wrapper
            table
                thead
                    tr
                        th Name
                        th Species
                        th Watering Frequency
                tbody
                    each plant in data
                        tr
                            td= plant.properties.name
                            td= plant.properties.species
                            td= plant.properties.watering_frequency
                    else
                        tr
                            td(colspan="3") No plants yet.
