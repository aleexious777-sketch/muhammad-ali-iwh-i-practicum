doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update Custom Object Form
        a.nav-link(href="/") Return to the homepage
        .form-wrapper
            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input(type="text" id="name" name="name" required)
                label(for="species") Species
                input(type="text" id="species" name="species")
                label(for="watering_frequency") Watering Frequency
                input(type="text" id="watering_frequency" name="watering_frequency")
                input(type="submit" value="Submit")
